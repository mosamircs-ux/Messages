<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#262563EB">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#292563EB" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="@color/pulse_card_surface_light" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/pulse_card_stroke_light" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
